# Bind address (host:port). Use 0.0.0.0 to expose on the LAN.
OLLAMA_HOST=127.0.0.1:11434

# How long a model stays in (V)RAM after the last request
OLLAMA_KEEP_ALIVE=24h

# How many models can be loaded simultaneously
# Set to 2 to keep one chat model + one embedding model warm (RAG-ready)
OLLAMA_MAX_LOADED_MODELS=2

# Concurrent requests handled per loaded model
OLLAMA_NUM_PARALLEL=1

# Faster attention kernels (Metal + CUDA). Set to 0 to disable.
OLLAMA_FLASH_ATTENTION=1